PROJECT_NAME=Edu RAG Assessment Question Generator
API_V1_STR=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edu_rag_db

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_MATERIAL_COLLECTION=material_chunks
QDRANT_QUESTION_COLLECTION=question_vectors
QDRANT_TIMEOUT_SECONDS=30

PROCESSED_DIR=storage/processed

# --- LLM (Gemini API) -------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
# 0 = tắt thinking (nhanh/rẻ), -1 = để Gemini tự quyết định
LLM_THINKING_BUDGET=0
# true: thiếu GEMINI_API_KEY thì dùng FakeLLMProvider (chỉ nên bật ở dev/test)
LLM_ALLOW_FAKE_FALLBACK=true

# --- Embeddings -------------------------------------------------------
# gemini: vector thật, cần GEMINI_API_KEY. fake: vector băm, chỉ dùng offline/test.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# --- RAG retrieval ----------------------------------------------------
RAG_TOP_K=8
RAG_QUERY_EXPANSION=true
RAG_MAX_CONTEXT_CHARS=24000
RAG_MIN_SCORE=0.0

# --- Sinh & kiểm tra câu hỏi -----------------------------------------
GENERATION_MAX_ATTEMPTS=3
DUPLICATE_THRESHOLD=0.92
NEAR_DUPLICATE_TEXT_RATIO=0.9
# Bật judge sẽ tăng gấp đôi số lần gọi Gemini, đổi lại chất lượng cao hơn.
ENABLE_LLM_JUDGE=false
LLM_JUDGE_MIN_SCORE=0.6
